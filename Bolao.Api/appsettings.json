{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "ApiFutebol": {
    "BaseUrl": "",
    "Token": ""
  },

  "AdminFirebaseUids": [],

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },

  "AllowedHosts": "*"
}